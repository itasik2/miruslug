# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Railway Redis / compatible Redis
REDIS_URL="redis://default:PASSWORD@HOST:6379"

# NestJS API / Railway
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Next.js / Vercel server-side proxy target
# In Vercel set this to the public Railway API URL, without a trailing slash.
MIRUSLUG_API_URL="http://127.0.0.1:4000"

# Meta webhook verification and signature validation
META_VERIFY_TOKEN=""
META_APP_SECRET=""

# Outbound channel credentials, reserved for the delivery step
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""
